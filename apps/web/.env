# Data source for /api/*. false is the real Azure Functions API backed by
# Microsoft Fabric; true serves the in-browser mock API (Mock Service Worker)
# from the wireframe's generated data.
#
# Switched to false on 29 Sep 2026, once steps 4-9 had built and verified
# every endpoint the app calls. main.tsx unregisters the mock service worker
# whenever this is false, because that registration outlives the flag and
# would otherwise stay installed in the browser of anyone who saw the demo.
VITE_USE_MOCKS=false
